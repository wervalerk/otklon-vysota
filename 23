#!/usr/bin/env python3
"""
Высотные отклонения от проектной плоскости (отметки).
Файл: vysota_otklon.py

Вход: TXT (№, X, Y, H) в метрах.
- Анализирует высоты, предлагает проектную отметку Hпр с округлением до 1 см
  (медиана основного кластера).
- Спрашивает подтверждение или ввод своей Hпр.
- Считает отклонения δ = (Hфакт − Hпр) · 1000 мм, округление до 1 мм.
- Выводит DXF + PNG с подписями отклонений у точек
  (красный при |δ| > TOL_MM, по умолчанию 20 мм — как в СП 70.13330).
- Сводка: min/max/mean/σ, кол-во сверх допуска.

Использование (CLI):
  python vysota_otklon.py points.txt
  python vysota_otklon.py points.txt --h 171.18
  python vysota_otklon.py points.txt --h 171.18 --tol 20 --out outdir

Для бота: функции parse_txt_heights, suggest_h, compute_devs, write_height_dxf/png
можно вызывать из aiogram-хендлеров по тому же паттерну, что в bot_exec_plan / otcl_plan.
"""

from __future__ import annotations

import argparse
import math
import os
import re
import statistics
import sys
from collections import Counter
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional, Tuple

import ezdxf
from ezdxf import units

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Circle
from matplotlib import font_manager as fm

# ─────────────────────────── настройки ───────────────────────────
TOL_MM_DEFAULT = 20.0          # допуск по высоте (мм), как п.4–5 в ИГС
RED_MM = 20.0
OUTLIER_M = 0.40               # отбрасывать точки дальше медианы на столько м
ROUND_CM = 0.01                # округление предлагаемой отметки до 1 см
TEXT_H = 0.12                  # высота текста в DXF (м)
PT_R = 0.04                    # радиус точки


@dataclass
class HeightPoint:
    pid: str
    x: float
    y: float
    z: float
    dev_mm: float = 0.0
    over: bool = False


@dataclass
class HeightData:
    points: List[HeightPoint] = field(default_factory=list)
    h_prj: float = 0.0
    tol_mm: float = TOL_MM_DEFAULT
    suggested: float = 0.0
    n_outliers: int = 0
    stats: Dict[str, float] = field(default_factory=dict)


def num(tok: str) -> float:
    return float(tok.replace(",", ".").strip())


def parse_txt_heights(path: str, units_m: bool = True) -> List[Tuple[str, float, float, float]]:
    """Парсит TXT: № X Y H  (запятые/пробелы, комментарии #). Возвращает список (pid,x,y,z) в метрах."""
    points = []
    k = 1.0 if units_m else 0.001
    for raw in Path(path).read_text(encoding="utf-8-sig", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        s = line.replace(";", " ").replace("\t", " ")
        if re.search(r"\s", s):
            s = re.sub(r"(?<=\d),(?=\d)", ".", s)
            s = s.replace(",", " ")
            toks = s.split()
        else:
            toks = s.split(",")
        fields = [t.strip() for t in toks if t.strip()]
        if len(fields) < 4:
            continue
        try:
            pid = fields[0]
            x, y, z = (num(v) * k for v in fields[1:4])
            points.append((pid, x, y, z))
        except (ValueError, IndexError):
            continue
    if not points:
        raise ValueError(f"В файле {path} нет ни одной точки с 4 полями.")
    return points


def suggest_h(zs: List[float], round_to: float = ROUND_CM) -> Tuple[float, dict]:
    """
    Предлагает Hпр: медиана основного кластера (без выбросов),
    округлённая до 1 см.
    Возвращает (H, info).
    """
    if not zs:
        raise ValueError("Нет высот")
    med0 = statistics.median(zs)
    core = [z for z in zs if abs(z - med0) <= OUTLIER_M]
    if len(core) < max(3, len(zs) // 5):
        core = zs[:]
    med = statistics.median(core)
    # округление к ближайшему 0.01
    h = round(med / round_to) * round_to
    # чуть «красивее»: если очень близко к .x5/.x0 — оставить
    info = {
        "n": len(zs),
        "n_core": len(core),
        "median_raw": med0,
        "median_core": med,
        "mean_core": statistics.mean(core),
        "min_core": min(core),
        "max_core": max(core),
        "suggested": h,
    }
    return h, info


def compute_devs(
    raw: List[Tuple[str, float, float, float]],
    h_prj: float,
    tol_mm: float = TOL_MM_DEFAULT,
) -> HeightData:
    """Считает отклонения в мм, отбрасывает явные выбросы из статистики."""
    pts = []
    for pid, x, y, z in raw:
        dmm = (z - h_prj) * 1000.0
        # округление до целых мм (как на схемах)
        dmm_r = round(dmm)
        over = abs(dmm_r) > tol_mm
        pts.append(HeightPoint(pid=pid, x=x, y=y, z=z, dev_mm=dmm_r, over=over))

    # статистика только по «нормальным» (не далеко от H)
    good = [p for p in pts if abs(p.z - h_prj) <= OUTLIER_M]
    n_out = len(pts) - len(good)
    if not good:
        good = pts
    devs = [p.dev_mm for p in good]
    stats = {
        "n": len(pts),
        "n_good": len(good),
        "n_outliers": n_out,
        "min_mm": min(devs),
        "max_mm": max(devs),
        "mean_mm": statistics.mean(devs),
        "median_mm": statistics.median(devs),
        "std_mm": statistics.pstdev(devs) if len(devs) > 1 else 0.0,
        "n_over": sum(1 for p in good if p.over),
        "rms_mm": math.sqrt(sum(d * d for d in devs) / len(devs)),
    }
    return HeightData(
        points=pts,
        h_prj=h_prj,
        tol_mm=tol_mm,
        suggested=h_prj,
        n_outliers=n_out,
        stats=stats,
    )


def _fmt_dev(d: float) -> str:
    """Подпись как на схемах: +3 / −5 / 0"""
    if abs(d) < 0.5:
        return "0"
    s = f"{d:+.0f}"
    return s.replace("+", "+").replace("-", "−")  # типографский минус


def write_height_dxf(path: str, data: HeightData, title: str = "") -> None:
    """DXF: точки + подписи отклонений в мм."""
    doc = ezdxf.new("R2010")
    doc.units = units.M
    msp = doc.modelspace()

    # слои
    doc.layers.add("POINTS", color=7)
    doc.layers.add("DEVS", color=3)          # зелёный — в допуске
    doc.layers.add("DEVS_OVER", color=1)     # красный — сверх
    doc.layers.add("TEXT", color=7)
    doc.layers.add("TITLE", color=5)

    for p in data.points:
        layer = "DEVS_OVER" if p.over else "DEVS"
        # крест / круг
        msp.add_circle((p.x, p.y), radius=PT_R, dxfattribs={"layer": "POINTS", "color": 7})
        # подпись
        txt = _fmt_dev(p.dev_mm)
        msp.add_text(
            txt,
            dxfattribs={
                "layer": layer,
                "height": TEXT_H,
                "color": 1 if p.over else 3,
                "style": "Standard",
            },
        ).set_placement((p.x + PT_R * 1.6, p.y + PT_R * 0.3))

    # заголовок
    if data.points:
        xs = [p.x for p in data.points]
        ys = [p.y for p in data.points]
        cx, cy = (min(xs) + max(xs)) / 2, max(ys) + 1.5
        h_txt = f"Hпр = {data.h_prj:.3f} м   δ = (Hфакт − Hпр)·1000 мм   допуск ±{data.tol_mm:.0f} мм"
        if title:
            h_txt = title + "  |  " + h_txt
        msp.add_text(
            h_txt,
            dxfattribs={"layer": "TITLE", "height": 0.25, "color": 5},
        ).set_placement((min(xs), cy))

        # сводка
        st = data.stats
        summ = (
            f"N={st['n']}  min={st['min_mm']:+.0f}  max={st['max_mm']:+.0f}  "
            f"mean={st['mean_mm']:+.1f}  σ={st['std_mm']:.1f}  "
            f"сверх={st['n_over']}"
        )
        msp.add_text(
            summ,
            dxfattribs={"layer": "TITLE", "height": 0.18, "color": 5},
        ).set_placement((min(xs), cy - 0.45))

    doc.saveas(path)


def write_height_png(path: str, data: HeightData, title: str = "", dpi: int = 160) -> None:
    """PNG-превью с точками и подписями отклонений."""
    fig, ax = plt.subplots(figsize=(14, 10), dpi=dpi)
    ax.set_aspect("equal")
    ax.grid(True, linestyle=":", alpha=0.4)

    xs = [p.x for p in data.points]
    ys = [p.y for p in data.points]
    if not xs:
        plt.close(fig)
        return

    for p in data.points:
        color = "#c0392b" if p.over else "#27ae60"
        ax.plot(p.x, p.y, "o", ms=4, color=color, zorder=3)
        ax.annotate(
            _fmt_dev(p.dev_mm),
            (p.x, p.y),
            xytext=(4, 3),
            textcoords="offset points",
            fontsize=7,
            color=color,
            fontweight="bold" if p.over else "normal",
            zorder=4,
        )

    st = data.stats
    head = title or "Высотные отклонения"
    head += f"\nHпр = {data.h_prj:.3f} м   допуск ±{data.tol_mm:.0f} мм"
    head += (
        f"\nN={st['n']}  min={st['min_mm']:+.0f}  max={st['max_mm']:+.0f}  "
        f"mean={st['mean_mm']:+.1f}  σ={st['std_mm']:.1f} мм  сверх допуска: {st['n_over']}"
    )
    ax.set_title(head, fontsize=11, loc="left")
    ax.set_xlabel("X, м")
    ax.set_ylabel("Y, м")

    # немного отступа
    pad = max(max(xs) - min(xs), max(ys) - min(ys), 1) * 0.05
    ax.set_xlim(min(xs) - pad, max(xs) + pad)
    ax.set_ylim(min(ys) - pad, max(ys) + pad * 1.3)

    fig.tight_layout()
    fig.savefig(path, dpi=dpi, bbox_inches="tight", facecolor="white")
    plt.close(fig)


def make_report(data: HeightData, src_name: str) -> str:
    st = data.stats
    lines = [
        f"Файл: {src_name}",
        f"Проектная отметка Hпр = {data.h_prj:.3f} м",
        f"Допуск: ±{data.tol_mm:.0f} мм",
        f"Точек: {st['n']} (в статистике {st['n_good']}, выбросов {st['n_outliers']})",
        f"Отклонения, мм:",
        f"  min = {st['min_mm']:+.0f}",
        f"  max = {st['max_mm']:+.0f}",
        f"  mean = {st['mean_mm']:+.2f}",
        f"  median = {st['median_mm']:+.1f}",
        f"  σ = {st['std_mm']:.2f}",
        f"  RMS = {st['rms_mm']:.2f}",
        f"  сверх допуска (|δ|>{data.tol_mm:.0f}): {st['n_over']}",
        "",
        "pid;X;Y;Z;δ_мм;сверх",
    ]
    for p in sorted(data.points, key=lambda r: (0, int(r.pid)) if r.pid.isdigit() else (1, r.pid)):
        lines.append(
            f"{p.pid};{p.x:.4f};{p.y:.4f};{p.z:.4f};{p.dev_mm:+.0f};{'ДА' if p.over else ''}"
        )
    return "\n".join(lines)


def process_file(
    txt_path: str,
    h_prj: Optional[float] = None,
    tol_mm: float = TOL_MM_DEFAULT,
    out_dir: Optional[str] = None,
    interactive: bool = True,
) -> HeightData:
    """Основной пайплайн."""
    raw = parse_txt_heights(txt_path)
    zs = [z for _, _, _, z in raw]
    suggested, info = suggest_h(zs)

    print("=" * 60)
    print(f"Файл: {Path(txt_path).name}")
    print(f"Точек: {info['n']}  (ядро без выбросов: {info['n_core']})")
    print(f"Медиана сырая: {info['median_raw']:.4f} м")
    print(f"Медиана ядра:  {info['median_core']:.4f} м")
    print(f"Среднее ядра:  {info['mean_core']:.4f} м")
    print(f"Диапазон ядра: {info['min_core']:.4f} … {info['max_core']:.4f} м")
    print(f"→ Предлагаемая Hпр (округление до 1 см): {suggested:.2f} м")
    print("=" * 60)

    if h_prj is None:
        if interactive and sys.stdin.isatty():
            ans = input(f"Принять Hпр = {suggested:.2f} м? [Enter=да / введите своё]: ").strip()
            if ans:
                h_prj = num(ans)
            else:
                h_prj = suggested
        else:
            h_prj = suggested
            print(f"(неинтерактивно) принята Hпр = {h_prj:.2f} м")
    else:
        print(f"Задана Hпр = {h_prj:.3f} м")

    data = compute_devs(raw, h_prj, tol_mm)
    data.suggested = suggested

    stem = Path(txt_path).stem
    if out_dir is None:
        out_dir = str(Path(txt_path).parent / f"height_{stem}")
    Path(out_dir).mkdir(parents=True, exist_ok=True)

    dxf_path = os.path.join(out_dir, f"{stem}_height.dxf")
    png_path = os.path.join(out_dir, f"{stem}_height.png")
    csv_path = os.path.join(out_dir, f"{stem}_height.csv")
    txt_rep = os.path.join(out_dir, f"{stem}_height_report.txt")

    title = f"{stem}  Hпр={h_prj:.3f}"
    write_height_dxf(dxf_path, data, title=title)
    write_height_png(png_path, data, title=title)
    Path(csv_path).write_text(make_report(data, Path(txt_path).name), encoding="utf-8")
    Path(txt_rep).write_text(make_report(data, Path(txt_path).name), encoding="utf-8")

    print(f"\nРезультаты:")
    print(f"  DXF:  {dxf_path}")
    print(f"  PNG:  {png_path}")
    print(f"  CSV/отчёт: {csv_path}")
    st = data.stats
    print(
        f"  min={st['min_mm']:+.0f}  max={st['max_mm']:+.0f}  "
        f"mean={st['mean_mm']:+.1f}  σ={st['std_mm']:.1f}  сверх={st['n_over']}"
    )
    return data


def main():
    ap = argparse.ArgumentParser(description="Высотные отклонения от плоскости (Hпр)")
    ap.add_argument("txt", help="TXT с точками №,X,Y,H")
    ap.add_argument("--h", type=float, default=None, help="Проектная отметка Hпр, м (если не указана — предложит)")
    ap.add_argument("--tol", type=float, default=TOL_MM_DEFAULT, help="Допуск, мм (по умолчанию 20)")
    ap.add_argument("--out", default=None, help="Папка для результатов")
    ap.add_argument("--yes", action="store_true", help="Не спрашивать, сразу принять предложенную H")
    args = ap.parse_args()

    process_file(
        args.txt,
        h_prj=args.h,
        tol_mm=args.tol,
        out_dir=args.out,
        interactive=not args.yes,
    )


if __name__ == "__main__":
    main()

